Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 16
      Color: 160; 160; 164
      Alpha: 0.4
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frames:
        All Enabled: false
        map:
          Value: true
        base_footprint:
          Value: true
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Marker Scale: 0.5
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: PileTruth (sim, gray)
      Enabled: true
      Topic:
        Value: /sim/pile_truth
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Color Transformer: FlatColor
      Color: 120; 120; 120
      Alpha: 0.25
      Style: Boxes
      Size (m): 0.03
      Decay Time: 0
      Queue Size: 10
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: PileCluster (light red)
      Enabled: true
      Topic:
        Value: /scrap_pile_skirt_node/cluster_points
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Color Transformer: RGB8
      Alpha: 1
      Style: Boxes
      Size (m): 0.04
      Decay Time: 0
      Queue Size: 10
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Graspable strip (green)
      Enabled: true
      Topic:
        Value: /scrap_pile_skirt_node/graspable_points
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Color Transformer: RGB8
      Alpha: 1
      Style: Boxes
      Size (m): 0.045
      Decay Time: 0
      Queue Size: 10
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Skirt (red)
      Enabled: true
      Topic:
        Value: /scrap_pile_skirt_node/skirt_points
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Color Transformer: RGB8
      Alpha: 1
      Style: Boxes
      Size (m): 0.06
      Decay Time: 0
      Queue Size: 10
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Body / nearest / strip
      Enabled: true
      Topic:
        Value: /scrap_pile_skirt_node/markers
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Planner (work line / goal / grasp)
      Enabled: true
      Topic:
        Value: /pickup_planner_node/markers
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Value: true
  Enabled: true
  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 6.5
      Focal Point:
        X: 1.8
        Y: 0.2
        Z: 0.3
      Pitch: 0.75
      Yaw: 3.6
      Target Frame: <Fixed Frame>
    Saved: ~
Window Geometry:
  Height: 1000
  Width: 1500
