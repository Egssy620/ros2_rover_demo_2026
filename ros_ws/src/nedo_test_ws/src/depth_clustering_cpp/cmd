# ビルド
cd ~/ros2_ws
colcon build --packages-select depth_clustering_cpp --symlink-install
source install/setup.bash

# Ouster ドライバ起動 (別ターミナル)
ros2 launch ouster_ros driver.launch.py params_file:=~/ros2_ws/ouster_params.yaml viz:=false

# 動作確認 (別ターミナル)
ros2 topic hz /ouster/range_image
ros2 topic hz /ouster/metadata
ros2 topic hz /depth_clustering/segments

# セグメンテーションノード起動
# メタデータはデフォルトで /ouster/metadata トピックから取得 (use_metadata_file=false)
ros2 run depth_clustering_cpp depth_clustering_node

# ファイルからメタデータを読む場合
# ros2 run depth_clustering_cpp depth_clustering_node --ros-args \
#   -p use_metadata_file:=true \
#   -p metadata_path:=/path/to/OS-1-32-metadata.json

# パラメータ調整例
ros2 run depth_clustering_cpp depth_clustering_node --ros-args \
  -p sensor_height:=0.385 \
  -p seed_convergence_threshold:=0.05 \
  -p min_normal_z:=0.85

# 簡易版 (PointCloud2のみ、メタデータ不要)
ros2 run depth_clustering_cpp depth_clustering_node_simple

source /opt/ros/humble/setup.bash && source /home/rover/ros2_ws/install/setup.bash &&    
             ros2 run depth_clustering_cpp depth_clustering_node --ros-args -p                     use_metadata_file:=true -p metadata_path:=/home/rover/ros2_ws/192.168.1-metadata.json

source /opt/ros/humble/setup.bash && source /home/rover/ros2_ws/install/setup.bash &&    
             ros2 launch ouster_ros driver.launch.py params_file:=/home/rover/ouster_params.yaml     
            viz:=false
